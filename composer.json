{
	"name": "wasp/wasp-cli",
	"description": "WASP CLI tool",
	"require": {
		"php": ">=8.1",
		"symfony/console": "^6.4",
		"symfony/finder": "^6.4",
		"symfony/filesystem": "^6.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"WaspCli\\": "cli/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WaspCli\\Tests\\": "cli/tests/"
		}
	},
	"bin": ["cli/wasp"],
	"scripts": {
		"test": "phpunit"
	}
}

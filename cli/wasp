#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = __DIR__ . '/../vendor/autoload.php';
if (! is_file($autoload)) {
    fwrite(STDERR, "WASP CLI: run composer install in the plugin root first.\n");
    exit(1);
}

require $autoload;

use WaspCli\Application;

$application = new Application(__DIR__);
$application->run();
